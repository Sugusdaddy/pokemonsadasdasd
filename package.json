{
  "name": "arena-royale",
  "private": true,
  "version": "3.0.0-phase0",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "tsx tools/ensure-assets.ts && npm run dev -w client",
    "build": "tsx tools/ensure-assets.ts && npm run build -w client",
    "preview": "npm run preview -w client",
    "assets": "tsx tools/build-assets.ts",
    "typecheck": "tsc -p shared && tsc -p client && tsc -p server && tsc -p tools",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "assets:fan-only": "tsx tools/build-assets.ts --fan-only"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^18.19.130",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^17.13.0",
    "maxrects-packer": "^2.7.3",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
