{
  "name": "arena-royale",
  "private": true,
  "version": "3.0.0-phase2a",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "tsx tools/ensure-assets.ts && concurrently -k -n db,server,client -c magenta,blue,green \"npm:dev:db\" \"npm:dev:server\" \"npm:dev:client\"",
    "build": "tsx tools/ensure-assets.ts && npm run build -w client",
    "preview": "npm run preview -w client",
    "assets": "tsx tools/build-assets.ts",
    "audio": "tsx tools/build-audio.ts",
    "icons": "tsx tools/build-icons.ts",
    "typecheck": "tsc -p shared && tsc -p client && tsc -p server && tsc -p tools",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "assets:fan-only": "tsx tools/build-assets.ts --fan-only",
    "dev:server": "node --watch-path=server/src --watch-path=shared/src --no-warnings=ExperimentalWarning --import tsx server/src/index.ts",
    "dev:client": "npm run dev -w client",
    "start:server": "tsx server/src/index.ts",
    "dev:db": "tsx tools/dev-db.ts",
    "db:migrate": "prisma migrate dev --schema server/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "db:studio": "prisma studio --schema server/prisma/schema.prisma",
    "postinstall": "prisma generate --schema server/prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^18.19.130",
    "@types/pngjs": "^6.0.5",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^17.13.0",
    "maxrects-packer": "^2.7.3",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
