// Base de datos de Arena Royale (PostgreSQL).
// Desarrollo: `npm run dev` arranca un PostgreSQL local (embedded-postgres).
// Producción: DATABASE_URL apunta al PostgreSQL de Railway.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Versión del balance de cartas (cambios de vida, daño, velocidad de ataque y coste). Vale la última.
model BalanceVersion {
  version   Int      @id @default(autoincrement())
  /// { carta: { hp?, dmg?, hitSpeed?, cost? } }
  overrides Json
  note      String
  adminId   String
  createdAt DateTime @default(now())
}

/// Uso y victorias de cada carta con cada versión de balance (mazos de jugadores, sin amistosas).
model CardStat {
  version Int
  key     String
  /// Partidas en las que la carta iba en el mazo de un jugador, cuántas ganó y cuántas veces se jugó.
  games   Int    @default(0)
  wins    Int    @default(0)
  plays   Int    @default(0)

  @@id([version, key])
}

/// Torneo creado por un jugador: dura unos minutos y se juega por código (o abierto a todos).
model Tournament {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  creatorId  String
  /// Reglas: classic | double | triple | sudden | draft
  rules      String
  maxPlayers Int
  isPublic   Boolean  @default(true)
  createdAt  DateTime @default(now())
  endsAt     DateTime
  players    TournamentPlayer[]

  @@index([endsAt])
  @@index([creatorId])
}

/// Jugador apuntado a un torneo, con su marcador.
model TournamentPlayer {
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  accountId    String
  name         String
  wins         Int        @default(0)
  losses       Int        @default(0)
  crowns       Int        @default(0)
  joinedAt     DateTime   @default(now())
  prizeClaimed Boolean    @default(false)

  @@id([tournamentId, accountId])
  @@index([accountId])
}

/// Una cuenta de jugador. Las de invitado no tienen wallet hasta que la conectan.
model Account {
  id          String   @id @default(cuid())
  isGuest     Boolean  @default(true)
  /// Copias de campos del estado para poder consultar y ordenar (rankings, admin).
  name        String
  trophies    Int      @default(0)
  maxTrophies Int      @default(0)
  kingLevel   Int      @default(1)
  /// Progreso completo (ProfileState de @arena/shared): cartas, mazos, balls, tienda…
  state       Json
  /// Versión del estado: cada cambio la sube (control de concurrencia optimista).
  rev         Int      @default(0)
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  /// Código para añadir amigos (se asigna la primera vez que hace falta).
  code        String?   @unique
  /// Silenciado en el chat hasta esta fecha (por denuncias o por un admin).
  mutedUntil  DateTime?
  wallets     Wallet[]
  clan        ClanMember?

  @@index([trophies])
}

/// Wallet de Solana vinculada a una cuenta (login firmando un mensaje, sin transacciones).
model Wallet {
  address   String   @id
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([accountId])
}

/// Código de un solo uso para el mensaje que firma la wallet.
model AuthNonce {
  nonce     String   @id
  address   String
  message   String
  expiresAt DateTime
}

/// Partida terminada con su repetición (semilla + inputs).
model Match {
  id      String   @id
  mode    String
  blueId  String?
  redId   String?
  winner  String?
  reason  String
  players Json
  crowns  Json
  ticks   Int
  /// Huella final del estado (uint32): re-ejecutar la repetición debe dar la misma.
  hash    BigInt
  replay  Json
  endedAt DateTime @default(now())

  @@index([endedAt])
  @@index([blueId])
  @@index([redId])
}

/// Temporada mensual (AAAA-MM). La fila se crea al empezar a cerrarla: así solo un proceso la cierra.
model Season {
  id        String    @id
  closingAt DateTime  @default(now())
  closedAt  DateTime?
  results   SeasonResult[]
}

/// Clasificación final de una temporada (se guarda el top al cerrarla).
model SeasonResult {
  seasonId  String
  season    Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  accountId String
  rank      Int
  name      String
  trophies  Int
  best      Int

  @@id([seasonId, accountId])
  @@index([seasonId, rank])
}

/// Amistad entre dos cuentas (a < b). Pendiente hasta que la acepta quien no la pidió.
model Friendship {
  a         String
  b         String
  requester String
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@id([a, b])
  @@index([b])
}

/// Invitación a una amistosa (código de sala) de un amigo a otro. Caduca en unos minutos.
model GameInvite {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  code      String
  createdAt DateTime @default(now())

  @@index([toId, createdAt])
}

model Clan {
  id          String        @id @default(cuid())
  name        String
  /// Nombre en minúsculas: dos clanes no pueden llamarse igual.
  nameKey     String        @unique
  description String        @default("")
  badge       Int           @default(0)
  /// open: cualquiera con los trofeos mínimos; closed: no entra nadie.
  type        String        @default("open")
  minTrophies Int           @default(0)
  createdAt   DateTime      @default(now())
  members     ClanMember[]
  messages    ClanMessage[]
}

/// Pertenencia a un clan (una cuenta solo puede estar en uno).
model ClanMember {
  accountId     String    @id
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  clanId        String
  clan          Clan      @relation(fields: [clanId], references: [id], onDelete: Cascade)
  /// leader | coLeader | elder | member
  role          String    @default("member")
  joinedAt      DateTime  @default(now())
  lastRequestAt DateTime?
  donations     Int       @default(0)

  @@index([clanId])
}

/// Mensaje del chat de clan: texto, petición de cartas o aviso del sistema.
model ClanMessage {
  id        String   @id @default(cuid())
  clanId    String
  clan      Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)
  accountId String?
  name      String
  /// text | request | system
  kind      String
  body      String
  card      String?
  want      Int      @default(0)
  got       Int      @default(0)
  donors    Json     @default("{}")
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  reports   Report[]

  @@index([clanId, createdAt])
}

/// Denuncia de un mensaje (una por jugador y mensaje).
model Report {
  id         String       @id @default(cuid())
  reporterId String
  targetId   String
  messageId  String?
  message    ClanMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  reason     String
  text       String
  /// Lo resolvió un admin (se guarda para el historial del jugador).
  resolved   Boolean      @default(false)
  createdAt  DateTime     @default(now())

  @@unique([reporterId, messageId])
  @@index([targetId])
  @@index([createdAt])
}

/// Idea del buzón. Cualquiera la propone; los admins le cambian el estado y responden.
model Idea {
  id        String     @id @default(cuid())
  accountId String
  name      String
  title     String
  body      String
  /// cards | balance | modes | ui | other
  category  String     @default("other")
  /// open | planned | done | rejected
  status    String     @default("open")
  reply     String     @default("")
  /// Votos (copia de COUNT(IdeaVote) para ordenar rápido).
  votes     Int        @default(0)
  hidden    Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  voters    IdeaVote[]

  @@index([status, votes])
  @@index([createdAt])
  @@index([accountId, createdAt])
}

/// Un voto por cuenta e idea.
model IdeaVote {
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  accountId String
  createdAt DateTime @default(now())

  @@id([ideaId, accountId])
}

/// Registro de lo que hace cada admin (quién, qué y sobre quién).
model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  adminName String
  action    String
  target    String   @default("")
  details   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
}
