# Copia este archivo a server/.env (no va a git).

# PostgreSQL. En desarrollo, `npm run dev` arranca uno local en este puerto.
# En Railway: la DATABASE_URL de su servicio PostgreSQL.
DATABASE_URL=postgresql://arena:arena@localhost:54329/arena

# Secreto para firmar las sesiones. En producción: largo y aleatorio (32+ caracteres, o no arranca)
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia-esto

# Dominio que aparece en el mensaje que firma la wallet (en producción, el de tu web).
# Si no se pone, se usa el de la página desde la que se juega.
# PUBLIC_DOMAIN=arenaroyale.example.com

# "Modo prueba" de Perfil (+oro, +gemas, +trofeos). Solo en desarrollo.
ALLOW_DEV_CHEATS=1

# Webs desde las que se puede jugar (CORS), separadas por comas. Obligatorio en producción.
# Un * dentro del nombre vale para las vistas previas: https://arena-royale-*-equipo.vercel.app
# CORS_ORIGINS=https://arena-royale.vercel.app

# Al apagar (despliegue), segundos que tienen las partidas en curso para terminar.
# Por defecto: 300 en producción, 0 en desarrollo.
# SHUTDOWN_DRAIN_SECONDS=300

# Puerto del servidor de juego en desarrollo (en producción se usa PORT).
# ARENA_PORT=2567

# Wallets de Solana con acceso a la pestaña de admin (direcciones públicas, separadas por comas).
# Se entra en el juego con esa wallet y aparece la pestaña "Admin".
# ADMIN_WALLETS=TuDireccionPublicaDeSolana

# Errores a Sentry (opcional). Sin esto no se carga el SDK ni se manda nada.
# El DSN está en Sentry → Project Settings → Client Keys. Sin datos personales ni cabeceras.
# SENTRY_DSN=https://clave@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
